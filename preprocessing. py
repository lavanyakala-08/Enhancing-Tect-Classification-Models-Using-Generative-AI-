import torch
import torch.nn as nn
from transformers import AutoModel, AutoTokenizer

class BertClassifierModel(nn.Module):
    def __init__(self, model_name="distilbert-base-uncased", num_classes=2):
        super(BertClassifierModel, self).__init__()
        # Using DistilBERT for faster training & lower footprint
        self.encoder = AutoModel.from_pretrained(model_name)
        self.dropout = nn.Dropout(0.3)
        self.classifier = nn.Linear(self.encoder.config.hidden_size, num_classes)

    def forward(self, input_ids, attention_mask):
        outputs = self.encoder(input_ids=input_ids, attention_mask=attention_mask)
        # Use pooler token or first [CLS] token vector state representation
        hidden_state = outputs.last_hidden_state[:, 0, :]
        x = self.dropout(hidden_state)
        logits = self.classifier(x)
        return logits

def get_tokenizer(model_name="distilbert-base-uncased"):
    return AutoTokenizer.from_pretrained(model_name)
